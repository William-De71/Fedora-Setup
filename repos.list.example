# =============================================================================
# Dépôts DNF tiers gérés par fedora-setup.sh
#
# Chaque ligne décrit un dépôt à ajouter, en 3 champs séparés par « | » :
#
#     nom | url_de_la_cle_gpg | url_du_fichier.repo
#
#   - nom            : identifiant lisible (sert au nom du fichier .repo et à
#                      la question posée à l'écran)
#   - url_cle_gpg    : clé GPG publique du dépôt (importée avant l'ajout)
#   - url_repo       : fichier .repo officiel de l'éditeur, téléchargé dans
#                      /etc/yum.repos.d/
#
# Le script DEMANDE pour chaque dépôt s'il faut l'ajouter (sauf en mode --yes).
# Une fois un dépôt ajouté, installez ses paquets normalement via rpm.list
# (ex. add:vivaldi-stable, add:code, add:sublime-text, add:VirtualBox-7.1).
#
# Lignes vides et lignes commençant par # : ignorées.
# =============================================================================

# Navigateur Vivaldi           -> paquet : vivaldi-stable
vivaldi | https://repo.vivaldi.com/archive/linux_signing_key.pub | https://repo.vivaldi.com/archive/vivaldi-fedora.repo

# VS Code (Microsoft)          -> paquet : code
# (existe aussi en Flatpak com.visualstudio.code : choisir l'un OU l'autre)
vscode | https://packages.microsoft.com/keys/microsoft.asc | https://packages.microsoft.com/yumrepos/vscode/config.repo

# Sublime Text / Merge         -> paquets : sublime-text , sublime-merge
sublime-text | https://download.sublimetext.com/sublimehq-pub.gpg | https://download.sublimetext.com/rpm/stable/x86_64/sublime-text.repo

# VirtualBox (Oracle)          -> paquet : VirtualBox-7.1 (adapter la version)
virtualbox | https://www.virtualbox.org/download/oracle_vbox_2016.asc | https://download.virtualbox.org/virtualbox/rpm/fedora/virtualbox.repo
